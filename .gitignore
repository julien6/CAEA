# Reviewer artifact: only explicitly selected top-level content is published.
/*
!/.gitignore
!/README.md
!/LICENSE
!/Makefile
!/poc/
!/docs/
!/tools/
!/results/

# Manuscripts, author working notes, cluster credentials/manual and original
# unfiltered run directories remain local. Reviewer data are exported to results/.
/paper/
/experiments/
/research/
/reports/
/*paper_recipe.md
/occidata_manual.md

# Runtime and build products (never scientific results).
**/__pycache__/
*.py[cod]
**/.venv/
**/*.egg-info/
**/.pytest_cache/
**/.env
/results/unpacked/
/results/.building/
